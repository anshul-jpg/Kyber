{
  "companion-interceptor": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/interceptor.js",
            "timeout": 130
          }
        ]
      }
    ]
  }
}