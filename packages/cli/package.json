{
  "name": "@agy-companion/cli",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agy-companion": "dist/bin/agy-companion.js",
    "kyber": "dist/bin/agy-companion.js"
  },
  "scripts": {
    "build:tsc": "tsc",
    "bundle": "esbuild src/bin/agy-companion.ts --bundle --outfile=dist/bin/agy-companion.cjs --platform=node --target=node18 --format=cjs && node -e \"fs.writeFileSync('dist/bin/agy-companion.js', '#!/usr/bin/env node\\nimport \\'./agy-companion.cjs\\';\\n')\"",
    "build": "tsc && npm run bundle",
    "dev": "tsx src/bin/agy-companion.ts",
    "start": "node dist/bin/agy-companion.js",
    "test": "tsc && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@agy-companion/protocol": "^0.1.0",
    "cloudflared": "^0.7.3",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  }
}
